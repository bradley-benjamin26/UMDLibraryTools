{
  "manifest_version": 3,
  "name": "UMD Library Tools",
  "version": "0.2.0",
  "description": "Provides library access and discovery tools for scholarly pages, including direct UMD proxy access, UMD Discover search, and research-help links.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://umcp.bncollege.com/*",
    "https://usmai-umcp.primo.exlibrisgroup.com/*",
    "https://usmai-umcp.alma.exlibrisgroup.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://umcp.bncollege.com/course-material-listing-page*"
      ],
      "js": [
        "searchIntelligence.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://scholar.google.com/scholar*"
      ],
      "js": [
        "searchIntelligence.js",
        "googleSearch.js"
      ],
      "css": [
        "googleSearch.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "searchIntelligence.js",
        "amazonSearch.js"
      ],
      "css": [
        "amazonSearch.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "proxyButton.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UMD Library Tools",
    "default_popup": "popup.html"
  }
}

